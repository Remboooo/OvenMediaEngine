<?xml version="1.0" encoding="UTF-8"?>
<!-- Traffic simulator OME (misc/traffic_sim). Never the production instance.
     live    = Bypass + opus (as the webrtc_impair harness app, plus SRT/HLS)
     livegpu = a production-like ladder (NVENC 1080/720/480, opus, thumbnails)
     OME listens on 127.0.0.1 only; sim_relay.py exposes signalling (33333) and ICE
     (34000-34005) on this machine's LAN address (OME_TEST_LAN_IP, which traffic_sim.py
     sets), so every WebRTC viewer goes through a per-viewer
     network class. Ports are separate from production (3333/1935/10000+), the
     webrtc_impair harness (23333/21935/24000+) and segcache dogfood (13333/11000+). -->
<Server version="8">
	<Name>OME-TrafficSim</Name>
	<Type>origin</Type>
	<IP>127.0.0.1</IP>

	<Bind>
		<Managers>
			<API>
				<Port>38081</Port>
				<WorkerCount>2</WorkerCount>
			</API>
		</Managers>
		<Providers>
			<RTMP>
				<Port>31935</Port>
			</RTMP>
			<SRT>
				<Port>39999</Port>
			</SRT>
		</Providers>
		<Publishers>
			<HLS>
				<Port>33333</Port>
			</HLS>
			<LLHLS>
				<Port>33333</Port>
			</LLHLS>
			<WebRTC>
				<Signalling>
					<Port>33333</Port>
				</Signalling>
				<IceCandidates>
					<IceCandidate>${env:OME_TEST_LAN_IP}:34000-34005/udp</IceCandidate>
				</IceCandidates>
			</WebRTC>
			<Thumbnail>
				<Port>33333</Port>
			</Thumbnail>
		</Publishers>
	</Bind>

	<Managers>
		<Host>
			<Names>
				<Name>*</Name>
			</Names>
		</Host>
		<API>
			<AccessToken>traffic-sim-local</AccessToken>
		</API>
	</Managers>

	<VirtualHosts>
		<VirtualHost>
			<Name>default</Name>
			<Host>
				<Names>
					<Name>*</Name>
				</Names>
			</Host>
			<Applications>
				<Application>
					<Name>live</Name>
					<Type>live</Type>
					<OutputProfiles>
						<OutputProfile>
							<Name>bypass</Name>
							<OutputStreamName>${OriginStreamName}</OutputStreamName>
							<Encodes>
								<Video>
									<Name>bypass_video</Name>
									<Bypass>true</Bypass>
								</Video>
								<Audio>
									<Name>opus</Name>
									<Codec>opus</Codec>
									<Bitrate>64000</Bitrate>
									<Samplerate>48000</Samplerate>
									<Channel>2</Channel>
								</Audio>
								<Audio>
									<Name>bypass_audio</Name>
									<Bypass>true</Bypass>
								</Audio>
							</Encodes>
							<Playlist>
								<Name>auto</Name>
								<FileName>auto</FileName>
								<Options>
									<WebRtcAutoAbr>true</WebRtcAutoAbr>
								</Options>
								<Rendition>
									<Name>Bypass+opus</Name>
									<Video>bypass_video</Video>
									<Audio>opus</Audio>
								</Rendition>
								<Rendition>
									<Name>Bypass</Name>
									<Video>bypass_video</Video>
									<Audio>bypass_audio</Audio>
								</Rendition>
							</Playlist>
						</OutputProfile>
					</OutputProfiles>
					<Providers>
						<RTMP><PacketSilenceTimeoutMs>10000</PacketSilenceTimeoutMs></RTMP>
						<SRT />
					</Providers>
					<Publishers>
						<AppWorkerCount>4</AppWorkerCount>
						<StreamWorkerCount>4</StreamWorkerCount>
						<WebRTC>
							<Timeout>30000</Timeout>
							<Rtx>true</Rtx>
							<Ulpfec>true</Ulpfec>
							<JitterBuffer>true</JitterBuffer>
							<JitterBufferDelay><Min>80</Min><Max>500</Max></JitterBufferDelay>
							<SendPacing>true</SendPacing>
							<VideoShedding>true</VideoShedding>
						</WebRTC>
						<LLHLS>
							<ChunkDuration>.2</ChunkDuration>
							<SegmentDuration>6</SegmentDuration>
							<SegmentCount>10</SegmentCount>
							<CrossDomains>
								<Url>*</Url>
							</CrossDomains>
						</LLHLS>
						<HLS>
							<SegmentCount>6</SegmentCount>
							<SegmentDuration>5</SegmentDuration>
						</HLS>
					</Publishers>
				</Application>
				<Application>
					<Name>livegpu</Name>
					<Type>live</Type>
					<OutputProfiles>
						<HardwareAcceleration>true</HardwareAcceleration>
						<OutputProfile>
							<Name>bypass</Name>
							<OutputStreamName>${OriginStreamName}</OutputStreamName>
							<Encodes>
								<Video>
									<Name>bypass_video</Name>
									<Bypass>true</Bypass>
								</Video>
								<!--Video>
									<Name>video_1080_hi</Name>
									<Codec>h264</Codec>
									<Bitrate>12000000</Bitrate>
									<Height>1080</Height>
									<Preset>slow</Preset>
									<BypassIfMatch>
										<Codec>eq</Codec>
										<Width>lte</Width>
										<Height>lte</Height>
									</BypassIfMatch>
								</Video-->
								<Video>
									<Name>video_1080</Name>
									<Codec>h264</Codec>
									<Bitrate>6000000</Bitrate>
									<Height>1080</Height>
									<BFrames>2</BFrames>
									<Preset>slower</Preset>
									<!--BypassIfMatch>
										<Codec>eq</Codec>
										<Width>lte</Width>
										<Height>lte</Height>
									</BypassIfMatch-->
								</Video>
								<Video>
									<Name>video_720</Name>
									<Codec>h264</Codec>
									<Bitrate>2500000</Bitrate>
									<Framerate>30.0</Framerate>
									<Height>720</Height>
									<BFrames>2</BFrames>
									<Preset>slower</Preset>
								</Video>
								<Video>
									<Name>video_480</Name>
									<Codec>h264</Codec>
									<Bitrate>500000</Bitrate>
									<Framerate>30.0</Framerate>
									<Height>480</Height>
									<BFrames>2</BFrames>
									<Preset>slower</Preset>
								</Video>
								<Audio>
									<Name>opus</Name>
									<Codec>opus</Codec>
									<Bitrate>64000</Bitrate>
									<Samplerate>48000</Samplerate>
									<Channel>2</Channel>
								</Audio>
								<Audio>
									<Name>bypass_audio</Name>
									<Bypass>true</Bypass>
								</Audio>
								<Image>
									<Codec>jpeg</Codec>
									<Framerate>.2</Framerate>
									<Height>720</Height>
								</Image>
							</Encodes>
							<!-- ABR master: Opus twins for WebRTC, +aac twins for LLHLS/HLS
							     (OME filters by protocol codec — opus-only tiers never appear in HLS). -->
							<Playlist>
								<Name>auto</Name>
								<FileName>auto</FileName>
								<Options>
									<WebRtcAutoAbr>true</WebRtcAutoAbr>
									<EnableTsPackaging>true</EnableTsPackaging>
								</Options>
								<Rendition>
									<Name>Bypass</Name>
									<Video>bypass_video</Video>
									<Audio>bypass_audio</Audio>
								</Rendition>
								<Rendition>
									<Name>Bypass+opus</Name>
									<Video>bypass_video</Video>
									<Audio>opus</Audio>
								</Rendition>
								<!--Rendition>
									<Name>1080phi</Name>
									<Video>video_1080_hi</Video>
									<Audio>opus</Audio>
								</Rendition-->
								<Rendition>
									<Name>1080p</Name>
									<Video>video_1080</Video>
									<Audio>opus</Audio>
								</Rendition>
								<Rendition>
									<Name>1080p+aac</Name>
									<Video>video_1080</Video>
									<Audio>bypass_audio</Audio>
								</Rendition>
								<Rendition>
									<Name>720p</Name>
									<Video>video_720</Video>
									<Audio>opus</Audio>
								</Rendition>
								<Rendition>
									<Name>720p+aac</Name>
									<Video>video_720</Video>
									<Audio>bypass_audio</Audio>
								</Rendition>
								<Rendition>
									<Name>480p</Name>
									<Video>video_480</Video>
									<Audio>opus</Audio>
								</Rendition>
								<Rendition>
									<Name>480p+aac</Name>
									<Video>video_480</Video>
									<Audio>bypass_audio</Audio>
								</Rendition>
							</Playlist>
							<!-- Test only (limits.py, playlist abr): auto ABR over the transcoded rungs. The
							     auto playlist starts at Bypass 4K, which headless Chromium cannot decode
							     in real time here, and ?rendition= turns auto ABR off. -->
							<Playlist>
								<Name>abr</Name>
								<FileName>abr</FileName>
								<Options>
									<WebRtcAutoAbr>true</WebRtcAutoAbr>
								</Options>
								<Rendition>
									<Name>1080p</Name>
									<Video>video_1080</Video>
									<Audio>opus</Audio>
								</Rendition>
								<Rendition>
									<Name>720p</Name>
									<Video>video_720</Video>
									<Audio>opus</Audio>
								</Rendition>
								<Rendition>
									<Name>480p</Name>
									<Video>video_480</Video>
									<Audio>opus</Audio>
								</Rendition>
							</Playlist>
							<Playlist>
								<Name>full</Name>
								<FileName>full</FileName>
								<Options>
									<EnableTsPackaging>true</EnableTsPackaging>
								</Options>
								<Rendition>
									<Name>Bypass</Name>
									<Video>bypass_video</Video>
									<Audio>bypass_audio</Audio>
								</Rendition>
								<Rendition>
									<Name>Bypass+opus</Name>
									<Video>bypass_video</Video>
									<Audio>opus</Audio>
								</Rendition>
							</Playlist>
							<!--Playlist>
								<Name>1080p 12Mbps</Name>
								<FileName>1080phi</FileName>
								<Rendition>
									<Name>1080hi+opus</Name>
									<Video>video_1080_hi</Video>
									<Audio>opus</Audio>
								</Rendition>
								<Rendition>
									<Name>1080hi</Name>
									<Video>video_1080_hi</Video>
									<Audio>bypass_audio</Audio>
								</Rendition>
							</Playlist-->
							<Playlist>
								<Name>1080p 6Mbps</Name>
								<FileName>1080p</FileName>
								<Options>
									<EnableTsPackaging>true</EnableTsPackaging>
								</Options>
								<Rendition>
									<Name>1080+opus</Name>
									<Video>video_1080</Video>
									<Audio>opus</Audio>
								</Rendition>
								<Rendition>
									<Name>1080</Name>
									<Video>video_1080</Video>
									<Audio>bypass_audio</Audio>
								</Rendition>

							</Playlist>
							<!--Playlist>
								<Name>720p 2.5Mbps</Name>
								<FileName>720p</FileName>
								<Rendition>
									<Name>720+opus</Name>
									<Video>video_720</Video>
									<Audio>opus</Audio>
								</Rendition>
								<Rendition>
									<Name>720</Name>
									<Video>video_720</Video>
									<Audio>bypass_audio</Audio>
								</Rendition>
							</Playlist-->
							<Playlist>
								<Name>480p 500kbps</Name>
								<FileName>480p</FileName>
								<Options>
									<EnableTsPackaging>true</EnableTsPackaging>
								</Options>
								<Rendition>
									<Name>480+opus</Name>
									<Video>video_480</Video>
									<Audio>opus</Audio>
								</Rendition>
								<Rendition>
									<Name>480</Name>
									<Video>video_480</Video>
									<Audio>bypass_audio</Audio>
								</Rendition>
							</Playlist>
						</OutputProfile>
					</OutputProfiles>
					<Providers>
						<RTMP><PacketSilenceTimeoutMs>10000</PacketSilenceTimeoutMs></RTMP>
						<SRT />
					</Providers>
					<Publishers>
						<AppWorkerCount>4</AppWorkerCount>
						<StreamWorkerCount>4</StreamWorkerCount>
						<WebRTC>
							<Timeout>30000</Timeout>
							<Rtx>true</Rtx>
							<Ulpfec>true</Ulpfec>
							<JitterBuffer>true</JitterBuffer>
							<JitterBufferDelay><Min>80</Min><Max>500</Max></JitterBufferDelay>
							<SendPacing>true</SendPacing>
							<VideoShedding>true</VideoShedding>
						</WebRTC>
						<LLHLS>
							<ChunkDuration>.2</ChunkDuration>
							<SegmentDuration>6</SegmentDuration>
							<SegmentCount>20</SegmentCount>
							<CrossDomains>
								<Url>*</Url>
							</CrossDomains>
						</LLHLS>
						<HLS>
							<SegmentCount>6</SegmentCount>
							<SegmentDuration>5</SegmentDuration>
							<CrossDomains>
								<Url>*</Url>
							</CrossDomains>
						</HLS>
						<Thumbnail>
							<CrossDomains>
								<Url>*</Url>
							</CrossDomains>	
						</Thumbnail>
					</Publishers>
				</Application>
			</Applications>
		</VirtualHost>
	</VirtualHosts>
</Server>
