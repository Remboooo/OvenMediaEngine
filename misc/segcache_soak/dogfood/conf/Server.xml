<?xml version="1.0" encoding="UTF-8"?>
<!-- Localhost dogfood OME for SegmentCache soak iteration. Does not touch the live service. -->
<Server version="8">
	<Name>OME-SegCache-Dogfood</Name>
	<Type>origin</Type>
	<IP>127.0.0.1</IP>

	<StunServer>stun.l.google.com:19302</StunServer>

	<Bind>
		<Managers>
			<API>
				<Port>18081</Port>
				<WorkerCount>2</WorkerCount>
			</API>
		</Managers>

		<Providers>
			<!-- Ingest unused — Schedule provider is application-scoped -->
		</Providers>

		<Publishers>
			<OVT>
				<Port>19000</Port>
			</OVT>
			<HLS>
				<Port>13333</Port>
			</HLS>
			<LLHLS>
				<Port>13333</Port>
			</LLHLS>
			<WebRTC>
				<Signalling>
					<Port>13333</Port>
				</Signalling>
				<IceCandidates>
					<IceCandidate>127.0.0.1:11000-11005/udp</IceCandidate>
				</IceCandidates>
			</WebRTC>
		</Publishers>
	</Bind>

	<Managers>
		<Host>
			<Names>
				<Name>127.0.0.1</Name>
			</Names>
		</Host>
		<API>
			<AccessToken>dogfood-segcache-local</AccessToken>
		</API>
	</Managers>

	<VirtualHosts>
		<VirtualHost>
			<Name>default</Name>
			<Host>
				<Names>
					<Name>127.0.0.1</Name>
					<Name>localhost</Name>
				</Names>
			</Host>
			<Applications>
				<Application>
					<Name>_filler</Name>
					<Type>live</Type>
					<OutputProfiles>
						<OutputProfile>
							<Name>bypass</Name>
							<OutputStreamName>stream</OutputStreamName>
							<Encodes>
								<Video>
									<Name>bypass_video</Name>
									<Bypass>true</Bypass>
								</Video>
								<Audio>
									<Name>bypass_audio</Name>
									<Bypass>true</Bypass>
								</Audio>
							</Encodes>
							<Playlist>
								<Name>hls</Name>
								<FileName>hls</FileName>
								<Options>
									<EnableTsPackaging>true</EnableTsPackaging>
								</Options>
								<Rendition>
									<Name>Bypass</Name>
									<Video>bypass_video</Video>
									<Audio>bypass_audio</Audio>
								</Rendition>
							</Playlist>
						</OutputProfile>
					</OutputProfiles>
					<Providers>
						<Schedule>
							<MediaRootDir>/opt/ovenmediaengine/media</MediaRootDir>
							<ScheduleFilesDir>/mnt/zfs/rem/dev/OvenMediaEngine/misc/segcache_soak/dogfood/schedules</ScheduleFilesDir>
							<SegmentCache>
								<Enable>true</Enable>
								<Mode>persist</Mode>
								<Hydrate>
									<Mode>greedy</Mode>
									<MaxThreads>2</MaxThreads>
									<MaxThroughputMbps>200</MaxThroughputMbps>
								</Hydrate>
								<IdleGracePeriodMs>15000</IdleGracePeriodMs>
							</SegmentCache>
						</Schedule>
					</Providers>
					<Publishers>
						<OVT />
						<WebRTC>
							<Timeout>30000</Timeout>
							<Rtx>true</Rtx>
							<Ulpfec>true</Ulpfec>
							<JitterBuffer>true</JitterBuffer>
						</WebRTC>
						<LLHLS>
							<ChunkDuration>.2</ChunkDuration>
							<SegmentDuration>6</SegmentDuration>
							<SegmentCount>10</SegmentCount>
							<CrossDomains>
								<Url>*</Url>
							</CrossDomains>
						</LLHLS>
						<HLS>
							<SegmentCount>6</SegmentCount>
							<SegmentDuration>5</SegmentDuration>
							<CrossDomains>
								<Url>*</Url>
							</CrossDomains>
						</HLS>
					</Publishers>
				</Application>
			</Applications>
		</VirtualHost>
	</VirtualHosts>
</Server>
